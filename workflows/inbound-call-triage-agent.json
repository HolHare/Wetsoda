      ]
    },
    {
      "parameters": {
        "notice": "\u2753 Fallback / Unknown\nAdd: IVR menu, general queue"
      },
      "id": "e361af01-e33d-491f-b31a-d408c05e3545",
      "name": "\u2192 Other",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
