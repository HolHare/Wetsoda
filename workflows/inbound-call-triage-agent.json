      },
      "id": "e9c8d303-c2ef-492e-b0c9-64ebbc05de39",
      "name": "\u2192 Billing",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1540,
        400
      ]
    },
    {
      "parameters": {
        "notice": "\ud83d\udea8 Emergency Route\nAdd: Page on-call, immediate escalation"
      },
      "id": "147c8508-626d-42f2-ad03-d4db7ac8cb36",
      "name": "\u2192 Emergency",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
